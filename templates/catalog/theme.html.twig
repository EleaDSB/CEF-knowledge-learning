{% extends 'base.html.twig' %}

{% block title %}{{ theme.name }} — Knowledge Learning{% endblock %}

{% block body %}
<nav style="font-size:.9rem; margin-bottom:1rem; color:#666;">
    <a href="{{ path('app_home') }}">Formations</a> &rsaquo; {{ theme.name }}
</nav>

<h1 style="color:#00497c; margin-bottom:1.5rem;">{{ theme.name }}</h1>

<div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:1.5rem;">
    {% for cursus in theme.cursus %}
    <div style="background:#fff; border-radius:8px; padding:1.5rem; box-shadow:0 2px 8px rgba(0,0,0,.08); display:flex; flex-direction:column; gap:.75rem;">
        <h2 style="color:#0074c7; font-size:1.15rem;">{{ cursus.name }}</h2>

        <ul style="list-style:none; font-size:.9rem; color:#555; display:flex; flex-direction:column; gap:.3rem;">
            {% for lesson in cursus.lessons %}
            <li style="display:flex; justify-content:space-between;">
                <span>📖 Leçon {{ lesson.position }} : {{ lesson.name }}</span>
                <span style="color:#0074c7; font-weight:bold; white-space:nowrap; margin-left:.5rem;">{{ lesson.price }} €</span>
            </li>
            {% endfor %}
        </ul>

        <div style="display:flex; align-items:center; justify-content:space-between; margin-top:.5rem;">
            <span style="font-size:1.1rem; font-weight:bold; color:#384050;">Cursus : {{ cursus.price }} €</span>
            <a href="{{ path('app_cursus', {slug: cursus.slug}) }}" class="btn btn-primary">Voir le cursus</a>
        </div>
    </div>
    {% endfor %}
</div>
{% endblock %}
