{% extends 'base.html.twig' %}

{% block title %}{{ lesson.name }} — Knowledge Learning{% endblock %}

{% block body %}
<nav style="font-size:.9rem; margin-bottom:1rem; color:#666;">
    <a href="{{ path('app_home') }}">Formations</a> &rsaquo;
    <a href="{{ path('app_theme', {slug: lesson.cursus.theme.slug}) }}">{{ lesson.cursus.theme.name }}</a> &rsaquo;
    <a href="{{ path('app_cursus', {slug: lesson.cursus.slug}) }}">{{ lesson.cursus.name }}</a> &rsaquo;
    Leçon {{ lesson.position }}
</nav>

<div style="max-width:800px;">
    <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem; margin-bottom:2rem;">
        <h1 style="color:#00497c;">Leçon {{ lesson.position }} : {{ lesson.name }}</h1>
    </div>

    {# Vidéo placeholder #}
    <div style="background:#384050; border-radius:8px; height:340px; display:flex; align-items:center; justify-content:center; margin-bottom:2rem;">
        <span style="color:#c0c8d8; font-size:1.1rem;">▶ Vidéo — {{ lesson.name }}</span>
    </div>

    {# Contenu de la leçon #}
    <div style="background:#fff; border-radius:8px; padding:2rem; box-shadow:0 2px 8px rgba(0,0,0,.08); line-height:1.7; margin-bottom:2rem;">
        <h2 style="color:#00497c; margin-bottom:1rem;">Contenu de la leçon</h2>
        <p>{{ lesson.content }}</p>
    </div>

    {# Bouton de validation #}
    <div style="background:#fff; border-radius:8px; padding:1.5rem; box-shadow:0 2px 8px rgba(0,0,0,.08); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem;">
        <div>
            <strong>Valider cette leçon</strong>
            <p style="font-size:.9rem; color:#666; margin-top:.25rem;">
                Marquer la leçon comme complétée pour progresser vers la certification.
            </p>
        </div>
        <form method="post" action="{{ path('app_lesson_validate', {slug: lesson.slug}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('validate_lesson_' ~ lesson.id) }}">
            <button type="submit" class="btn btn-success">✓ Valider la leçon</button>
        </form>
    </div>

    <div style="margin-top:1.5rem;">
        <a href="{{ path('app_cursus', {slug: lesson.cursus.slug}) }}">&larr; Retour au cursus</a>
    </div>
</div>
{% endblock %}
