{% extends 'base.html.twig' %}

{% block title %}{{ cursus.name }} — Knowledge Learning{% endblock %}

{% block body %}
<nav style="font-size:.9rem; margin-bottom:1rem; color:#666;">
    <a href="{{ path('app_home') }}">Formations</a> &rsaquo;
    <a href="{{ path('app_theme', {slug: cursus.theme.slug}) }}">{{ cursus.theme.name }}</a> &rsaquo;
    {{ cursus.name }}
</nav>

<div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem; margin-bottom:2rem;">
    <div>
        <h1 style="color:#00497c; margin-bottom:.5rem;">{{ cursus.name }}</h1>
        <p style="color:#666; font-size:.95rem;">{{ cursus.lessons|length }} leçon{{ cursus.lessons|length > 1 ? 's' : '' }} · Thème : {{ cursus.theme.name }}</p>
    </div>

    {% if not app.user %}
        <a href="{{ path('app_login') }}" class="btn btn-primary">
            Connexion pour acheter
        </a>
    {% elseif hasCursus %}
        <span style="background:#82b864; color:#fff; padding:.45rem 1.1rem; border-radius:4px; font-size:.9rem;">
            ✓ Cursus débloqué
        </span>
    {% else %}
        <a href="{{ path('app_checkout_cursus', {id: cursus.id}) }}" class="btn btn-success">
            Acheter le cursus — {{ cursus.price }} €
        </a>
    {% endif %}
</div>

<div style="display:flex; flex-direction:column; gap:1rem;">
    {% for lesson in cursus.lessons %}
    {% set owned = hasCursus or (ownedLessons[lesson.id] is defined) %}
    <div style="background:#fff; border-radius:8px; padding:1.25rem 1.5rem; box-shadow:0 2px 8px rgba(0,0,0,.08); display:flex; justify-content:space-between; align-items:center; gap:1rem;">
        <div>
            <h3 style="color:#384050; font-size:1rem; margin-bottom:.25rem;">
                {% if owned %}✓{% else %}🔒{% endif %}
                Leçon {{ lesson.position }} : {{ lesson.name }}
            </h3>
            <span style="color:#0074c7; font-weight:bold; font-size:.95rem;">{{ lesson.price }} €</span>
        </div>

        <div style="display:flex; gap:.75rem; align-items:center; flex-shrink:0;">
            {% if owned %}
                <a href="{{ path('app_lesson', {slug: lesson.slug}) }}" class="btn btn-primary">Accéder</a>
            {% elseif app.user %}
                <a href="{{ path('app_checkout_lesson', {id: lesson.id}) }}" class="btn btn-outline" style="color:#0074c7; border-color:#0074c7;">
                    Acheter — {{ lesson.price }} €
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-outline" style="color:#0074c7; border-color:#0074c7;">Se connecter</a>
            {% endif %}
        </div>
    </div>
    {% endfor %}
</div>
{% endblock %}
