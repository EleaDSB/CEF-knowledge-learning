{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin — Knowledge Learning{% endblock %}

{% block body %}
<h1 style="color:#00497c; margin-bottom:1.5rem;">Tableau de bord</h1>

<div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:1.5rem; margin-bottom:2rem;">
    <div style="background:#0074c7; color:#fff; border-radius:8px; padding:1.5rem; text-align:center;">
        <div style="font-size:2rem; font-weight:bold;">{{ totalUsers }}</div>
        <div>Utilisateurs</div>
    </div>
    <div style="background:#82b864; color:#fff; border-radius:8px; padding:1.5rem; text-align:center;">
        <div style="font-size:2rem; font-weight:bold;">{{ totalPurchases }}</div>
        <div>Achats</div>
    </div>
</div>

<div style="background:#fff; border-radius:8px; padding:1.5rem; box-shadow:0 2px 8px rgba(0,0,0,.08);">
    <h2 style="color:#00497c; margin-bottom:1rem; font-size:1.1rem;">Derniers inscrits</h2>
    <table style="width:100%; border-collapse:collapse; font-size:.9rem;">
        <thead>
            <tr style="border-bottom:2px solid #e0eaf4; color:#0074c7;">
                <th style="text-align:left; padding:.5rem;">Nom</th>
                <th style="text-align:left; padding:.5rem;">Email</th>
                <th style="text-align:left; padding:.5rem;">Statut</th>
                <th style="text-align:left; padding:.5rem;">Rôle</th>
                <th style="text-align:left; padding:.5rem;">Inscrit le</th>
            </tr>
        </thead>
        <tbody>
            {% for user in recentUsers %}
            <tr style="border-bottom:1px solid #f0f4f8;">
                <td style="padding:.5rem;">{{ user.fullName }}</td>
                <td style="padding:.5rem;">{{ user.email }}</td>
                <td style="padding:.5rem;">
                    {% if user.isVerified %}
                        <span style="color:#82b864;">✓ Activé</span>
                    {% else %}
                        <span style="color:#cd2c2e;">✗ Non activé</span>
                    {% endif %}
                </td>
                <td style="padding:.5rem;">{{ user.roles|join(', ') }}</td>
                <td style="padding:.5rem;">{{ user.createdAt|date('d/m/Y') }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
